{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zuri:office-execution:v1",
  "title": "Zuri Office Execution Contract v1",
  "description": "Proposed, not yet wired to an API. Strict request, worker-assignment, event and capability envelopes for an Office control plane.",
  "oneOf": [
    { "$ref": "#/$defs/officeCommand" },
    { "$ref": "#/$defs/executionAssignment" },
    { "$ref": "#/$defs/executionEvent" },
    { "$ref": "#/$defs/capabilityDeclaration" }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "opaqueId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "attachmentRef": {
      "type": "object",
      "required": ["id", "name", "mimeType", "sizeBytes", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/opaqueId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "mimeType": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sizeBytes": { "type": "integer", "minimum": 0, "maximum": 8388608 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "turnStartPayload": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "message": {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": { "type": "string", "minLength": 1, "maxLength": 10000 },
            "attachments": {
              "type": "array",
              "maxItems": 5,
              "items": { "$ref": "#/$defs/attachmentRef" }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "officeCommand": {
      "type": "object",
      "required": ["kind", "contractVersion", "commandId", "idempotencyKey", "action", "expectedRevision", "payload"],
      "properties": {
        "kind": { "const": "office-command" },
        "contractVersion": { "const": "zuri.office-execution.v1" },
        "commandId": { "$ref": "#/$defs/uuid" },
        "idempotencyKey": { "type": "string", "minLength": 16, "maxLength": 128 },
        "action": { "enum": ["session.create", "turn.start", "turn.cancel", "interaction.respond"] },
        "expectedRevision": { "type": "integer", "minimum": 0 },
        "sessionId": { "$ref": "#/$defs/uuid" },
        "turnId": { "$ref": "#/$defs/uuid" },
        "payload": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "session.create" } }, "required": ["action"] },
          "then": {
            "not": { "anyOf": [{ "required": ["sessionId"] }, { "required": ["turnId"] }] },
            "properties": {
              "payload": {
                "type": "object",
                "required": ["roleId", "title"],
                "properties": {
                  "roleId": { "type": "string", "minLength": 1, "maxLength": 64 },
                  "title": { "type": "string", "minLength": 1, "maxLength": 120 },
                  "executionProfileId": { "$ref": "#/$defs/opaqueId" }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "turn.start" } }, "required": ["action"] },
          "then": {
            "required": ["sessionId", "turnId"],
            "properties": { "payload": { "$ref": "#/$defs/turnStartPayload" } }
          }
        },
        {
          "if": { "properties": { "action": { "const": "turn.cancel" } }, "required": ["action"] },
          "then": {
            "required": ["sessionId", "turnId"],
            "properties": { "payload": { "type": "object", "maxProperties": 0 } }
          }
        },
        {
          "if": { "properties": { "action": { "const": "interaction.respond" } }, "required": ["action"] },
          "then": {
            "required": ["sessionId", "turnId"],
            "properties": {
              "payload": {
                "type": "object",
                "required": ["interactionId", "decision"],
                "properties": {
                  "interactionId": { "$ref": "#/$defs/opaqueId" },
                  "decision": { "enum": ["approve", "reject", "answer"] },
                  "answer": { "type": "string", "minLength": 1, "maxLength": 6000 }
                },
              "allOf": [
                { "if": { "properties": { "decision": { "const": "answer" } }, "required": ["decision"] }, "then": { "required": ["answer"] } },
                { "if": { "properties": { "decision": { "enum": ["approve", "reject"] } }, "required": ["decision"] }, "then": { "not": { "required": ["answer"] } } }
              ],
                "additionalProperties": false
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "executionAssignment": {
      "type": "object",
      "required": ["kind", "contractVersion", "assignmentId", "claimId", "commandId", "jobId", "sessionId", "turnId", "adapterId", "adapterVersion", "action", "expectedRevision", "fencingToken", "leaseExpiresAt", "deadlineAt", "payload"],
      "properties": {
        "kind": { "const": "execution-assignment" },
        "contractVersion": { "const": "zuri.office-execution.v1" },
        "assignmentId": { "$ref": "#/$defs/uuid" },
        "claimId": { "$ref": "#/$defs/uuid" },
        "commandId": { "$ref": "#/$defs/uuid" },
        "jobId": { "$ref": "#/$defs/uuid" },
        "sessionId": { "$ref": "#/$defs/uuid" },
        "turnId": { "$ref": "#/$defs/uuid" },
        "adapterId": { "type": "string", "pattern": "^[a-z][a-z0-9._/-]{0,63}$" },
        "adapterVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "action": { "enum": ["turn.start", "turn.cancel"] },
        "expectedRevision": { "type": "integer", "minimum": 0 },
        "fencingToken": { "type": "integer", "minimum": 1 },
        "leaseExpiresAt": { "$ref": "#/$defs/timestamp" },
        "deadlineAt": { "$ref": "#/$defs/timestamp" },
        "payload": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "turn.start" } }, "required": ["action"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/turnStartPayload" } } }
        },
        {
          "if": { "properties": { "action": { "const": "turn.cancel" } }, "required": ["action"] },
          "then": { "properties": { "payload": { "type": "object", "maxProperties": 0 } } }
        }
      ],
      "additionalProperties": false
    },
    "executionEvent": {
      "type": "object",
        "required": ["kind", "contractVersion", "eventId", "assignmentId", "commandId", "jobId", "sessionId", "turnId", "fencingToken", "sequence", "revision", "cursor", "eventType", "status", "occurredAt", "payload"],
      "properties": {
        "kind": { "const": "execution-event" },
        "contractVersion": { "const": "zuri.office-execution.v1" },
        "eventId": { "$ref": "#/$defs/uuid" },
        "assignmentId": { "$ref": "#/$defs/uuid" },
        "commandId": { "$ref": "#/$defs/uuid" },
        "jobId": { "$ref": "#/$defs/uuid" },
        "sessionId": { "$ref": "#/$defs/uuid" },
        "turnId": { "$ref": "#/$defs/uuid" },
        "fencingToken": { "type": "integer", "minimum": 1 },
        "sequence": { "type": "integer", "minimum": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "cursor": { "type": "string", "minLength": 1, "maxLength": 512 },
        "eventType": { "enum": ["assignment.accepted", "turn.started", "turn.delta", "interaction.required", "cancel.requested", "cancel.acknowledged", "cancel.confirmed", "turn.completed", "turn.failed", "turn.unknown", "turn.reconciled"] },
        "status": { "enum": ["accepted", "running", "waiting", "cancel_requested", "cancel_acknowledged", "completed", "failed", "cancelled", "unknown"] },
        "occurredAt": { "$ref": "#/$defs/timestamp" },
        "payload": {
          "type": "object",
          "properties": {
            "delta": { "type": "string", "minLength": 1, "maxLength": 8000 },
            "summary": { "type": "string", "maxLength": 1000 },
            "errorCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
            "resultText": { "type": "string", "maxLength": 12000 },
            "interaction": {
              "type": "object",
              "required": ["interactionId", "kind", "expiresAt"],
              "properties": {
                "interactionId": { "$ref": "#/$defs/opaqueId" },
                "kind": { "enum": ["approval", "question"] },
                "expiresAt": { "$ref": "#/$defs/timestamp" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "receipt": {
          "type": "object",
          "properties": {
            "providerReceiptId": { "$ref": "#/$defs/opaqueId" },
            "terminationReceiptId": { "$ref": "#/$defs/opaqueId" },
            "completedAt": { "$ref": "#/$defs/timestamp" },
            "confirmedAt": { "$ref": "#/$defs/timestamp" }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        { "if": { "properties": { "eventType": { "const": "assignment.accepted" } }, "required": ["eventType"] }, "then": { "properties": { "status": { "const": "accepted" } } } },
        { "if": { "properties": { "eventType": { "const": "turn.started" } }, "required": ["eventType"] }, "then": { "properties": { "status": { "const": "running" } } } },
        { "if": { "properties": { "eventType": { "const": "turn.delta" } }, "required": ["eventType"] }, "then": { "properties": { "status": { "const": "running" }, "payload": { "required": ["delta"] } } } },
        { "if": { "properties": { "eventType": { "const": "interaction.required" } }, "required": ["eventType"] }, "then": { "properties": { "status": { "const": "waiting" }, "payload": { "required": ["interaction"] } } } },
        { "if": { "properties": { "eventType": { "const": "cancel.requested" } }, "required": ["eventType"] }, "then": { "properties": { "status": { "const": "cancel_requested" } } } },
        { "if": { "properties": { "eventType": { "const": "cancel.acknowledged" } }, "required": ["eventType"] }, "then": { "properties": { "status": { "const": "cancel_acknowledged" } } } },
        { "if": { "properties": { "eventType": { "const": "cancel.confirmed" } }, "required": ["eventType"] }, "then": { "required": ["receipt"], "properties": { "status": { "const": "cancelled" }, "receipt": { "required": ["terminationReceiptId", "confirmedAt"] } } } },
        { "if": { "properties": { "eventType": { "const": "turn.completed" } }, "required": ["eventType"] }, "then": { "required": ["receipt"], "properties": { "status": { "const": "completed" }, "receipt": { "required": ["providerReceiptId", "completedAt"] } } } },
        { "if": { "properties": { "eventType": { "const": "turn.failed" } }, "required": ["eventType"] }, "then": { "properties": { "status": { "const": "failed" }, "payload": { "required": ["errorCode"] } } } },
        { "if": { "properties": { "eventType": { "const": "turn.unknown" } }, "required": ["eventType"] }, "then": { "properties": { "status": { "const": "unknown" }, "payload": { "required": ["errorCode"] } } } },
        { "if": { "properties": { "eventType": { "const": "turn.reconciled" } }, "required": ["eventType"] }, "then": {
          "properties": { "status": { "enum": ["running", "completed", "failed", "cancelled", "unknown"] } },
          "allOf": [
            { "if": { "properties": { "status": { "const": "running" } }, "required": ["status"] }, "then": { "required": ["receipt"], "properties": { "receipt": { "required": ["providerReceiptId"] } } } },
            { "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] }, "then": { "required": ["receipt"], "properties": { "receipt": { "required": ["providerReceiptId", "completedAt"] } } } },
            { "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] }, "then": { "properties": { "payload": { "required": ["errorCode"] } } } },
            { "if": { "properties": { "status": { "const": "cancelled" } }, "required": ["status"] }, "then": { "required": ["receipt"], "properties": { "receipt": { "required": ["terminationReceiptId", "confirmedAt"] } } } },
            { "if": { "properties": { "status": { "const": "unknown" } }, "required": ["status"] }, "then": { "properties": { "payload": { "required": ["errorCode"] } } } }
          ]
        } }
      ],
      "additionalProperties": false
    },
    "capabilityDeclaration": {
      "type": "object",
      "required": ["kind", "contractVersion", "adapterId", "adapterVersion", "observedAt", "expiresAt", "maxConcurrentTurns", "maxAttachmentBytes", "models", "capabilities"],
      "properties": {
        "kind": { "const": "capability-declaration" },
        "contractVersion": { "const": "zuri.office-execution.v1" },
        "adapterId": { "type": "string", "pattern": "^[a-z][a-z0-9._/-]{0,63}$" },
        "adapterVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "maxConcurrentTurns": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "maxAttachmentBytes": { "type": "integer", "minimum": 0, "maximum": 104857600 },
        "models": { "type": "array", "maxItems": 200, "uniqueItems": true, "items": { "$ref": "#/$defs/opaqueId" } },
        "capabilities": {
          "type": "object",
          "required": ["sessionCreate", "sessionResume", "turnStreaming", "approvals", "questions", "attachments", "cancellation", "workspaceAccess", "crashRecovery"],
          "properties": {
            "sessionCreate": { "enum": ["supported", "unsupported", "unknown"] },
            "sessionResume": { "enum": ["supported", "unsupported", "unknown"] },
            "turnStreaming": { "enum": ["supported", "unsupported", "unknown"] },
            "approvals": { "enum": ["supported", "unsupported", "unknown"] },
            "questions": { "enum": ["supported", "unsupported", "unknown"] },
            "attachments": { "enum": ["supported", "unsupported", "unknown"] },
            "cancellation": { "enum": ["supported", "unsupported", "unknown"] },
            "workspaceAccess": { "enum": ["supported", "unsupported", "unknown"] },
            "crashRecovery": { "enum": ["supported", "unsupported", "unknown"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
